# 2. Funktion zur Berechnung der Gesamtrate mit exaktem 95%-KI
calc_overall_rate <- function(data, endpoint, endpoint_label) {
  N <- nrow(data)
  Responders <- sum(data[[endpoint]], na.rm = TRUE)
  
  rate <- if (N > 0) Responders / N else NA_real_
  
  ci <- if (N > 0) {
    binom.test(Responders, N)$conf.int
  } else {
    c(NA_real_, NA_real_)
  }
  
  tibble(
    Endpoint = endpoint_label,
    N = N,
    Responders = Responders,
    Rate_pct = 100 * rate,
    CI_lower_pct = 100 * ci[1],
    CI_upper_pct = 100 * ci[2],
    Rate_with_95_CI = if (is.na(rate)) {
      NA_character_
    } else {
      sprintf("%.1f%% (%.1f–%.1f%%)", 100 * rate, 100 * ci[1], 100 * ci[2])
    }
  )
}

