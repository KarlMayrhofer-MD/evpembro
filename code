# Funktion zur Extraktion von HR, 95% CI und p-Wert aus dem Cox-Modell
get_cox_results <- function(cox_model, endpoint_name) {
  sum_cox <- summary(cox_model)
  
  res <- data.frame(
    Endpoint   = endpoint_name,
    Subgroup   = gsub("HER2", "", rownames(sum_cox$coefficients)),
    HR         = round(sum_cox$coefficients[, "exp(coef)"], 2),
    CI_lower   = round(sum_cox$conf.int[, "lower .95"], 2),
    CI_upper   = round(sum_cox$conf.int[, "upper .95"], 2),
    p_value    = round(sum_cox$coefficients[, "Pr(>|z|)"], 4)
  ) %>%
    mutate(
      `HR (95% CI)` = paste0(HR, " (", CI_lower, "–", CI_upper, ")")
    ) %>%
    select(Endpoint, Subgroup, `HR (95% CI)`, p_value)
  
  return(res)
}

