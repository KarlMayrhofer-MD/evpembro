# Gesamtvergleich aller fünf Subgruppen

global_test <- function(data, endpoint) {

  tab <- table(
    factor(data$biomarker_group, levels = group_levels),
    factor(data[[endpoint]], levels = c(FALSE, TRUE))
  )

  # Leere Subgruppen und leere Response-Spalten entfernen
  tab <- tab[
    rowSums(tab) > 0,
    colSums(tab) > 0,
    drop = FALSE
  ]

  if (nrow(tab) < 2 || ncol(tab) < 2) {
    return(tibble(
      Test = "Nicht berechenbar",
      Statistic = NA_real_,
      P_value = NA_real_
    ))
  }

  chi <- suppressWarnings(
    chisq.test(tab, correct = FALSE)
  )

  if (any(chi$expected < 5)) {

    # Exakter Fisher-Freeman-Halton-Test mit Monte-Carlo-
    # Approximation für die 5 x 2-Tabelle
    ft <- fisher.test(
      tab,
      simulate.p.value = TRUE,
      B = 100000
    )

    tibble(
      Test = "Fisher-Exact-Test (Monte Carlo)",
      Statistic = NA_real_,
      P_value = ft$p.value
    )

  } else {

    tibble(
      Test = "Chi-Quadrat-Test",
      Statistic = unname(chi$statistic),
      P_value = chi$p.value
    )
  }
}

global_results <- imap_dfr(
  endpoint_names,
  function(label, endpoint) {
    global_test(dat_eval, endpoint) %>%
      mutate(Endpoint = label, .before = 1)
  }
)

print(global_results)



# Funktion für Referenzvergleiche definieren



reference_comparison <- function(data, endpoint, endpoint_label) {

  groups_to_compare <- setdiff(group_levels, reference_group)

  purrr::map_dfr(groups_to_compare, function(g) {

    d <- data %>%
      dplyr::filter(
        as.character(biomarker_group) %in%
          c(reference_group, g)
      )

    n_g <- sum(as.character(d$biomarker_group) == g)
    r_g <- sum(
      as.character(d$biomarker_group) == g &
        d[[endpoint]]
    )

    n_ref <- sum(
      as.character(d$biomarker_group) == reference_group
    )
    r_ref <- sum(
      as.character(d$biomarker_group) == reference_group &
        d[[endpoint]]
    )

    if (n_g == 0 || n_ref == 0) {
      return(tibble::tibble(
        Endpoint = endpoint_label,
        Subgruppe = g,
        Referenz = reference_group,
        N_Subgruppe = n_g,
        Responder_Subgruppe = r_g,
        N_Referenz = n_ref,
        Responder_Referenz = r_ref,
        OR = NA_real_,
        CI_lower = NA_real_,
        CI_upper = NA_real_,
        P_value = NA_real_
      ))
    }

    # Spalten: Vergleichsgruppe und Referenz
    # Zeilen: Responder und Non-Responder
    tab <- matrix(
      c(
        r_g, n_g - r_g,
        r_ref, n_ref - r_ref
      ),
      nrow = 2,
      dimnames = list(
        Response = c("Ja", "Nein"),
        Gruppe = c(g, reference_group)
      )
    )

    ft <- stats::fisher.test(tab)

    tibble::tibble(
      Endpoint = endpoint_label,
      Subgruppe = g,
      Referenz = reference_group,
      N_Subgruppe = n_g,
      Responder_Subgruppe = r_g,
      N_Referenz = n_ref,
      Responder_Referenz = r_ref,
      OR = unname(ft$estimate),
      CI_lower = ft$conf.int[1],
      CI_upper = ft$conf.int[2],
      P_value = ft$p.value
    )
  })
}

# Funktion auf alle drei Endpunkte anwenden

reference_results <- purrr::imap_dfr(
