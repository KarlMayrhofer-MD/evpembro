# Deskriptive Auswertung mit exaktem 95%-KI Clopper-Pearson

calc_rate <- function(data, endpoint, endpoint_label) {

  data %>%
    group_by(biomarker_group, .drop = FALSE) %>%
    summarise(
      N = n(),
      Responders = sum(.data[[endpoint]]),
      .groups = "drop"
    ) %>%
    rowwise() %>%
    mutate(
      Rate = if (N > 0) Responders / N else NA_real_,

      CI_lower = if (N > 0) {
        binom.test(Responders, N)$conf.int[1]
      } else {
        NA_real_
      },

      CI_upper = if (N > 0) {
        binom.test(Responders, N)$conf.int[2]
      } else {
        NA_real_
      },

      Endpoint = endpoint_label
    ) %>%
    ungroup() %>%
    mutate(
      Rate_pct = 100 * Rate,
      CI_lower_pct = 100 * CI_lower,
      CI_upper_pct = 100 * CI_upper,
      Rate_with_95_CI = ifelse(
        is.na(Rate),
        NA_character_,
        sprintf(
          "%.1f%% (%.1f–%.1f%%)",
          Rate_pct, CI_lower_pct, CI_upper_pct
        )
      )
    ) %>%
    select(
      Endpoint, biomarker_group, N, Responders,
      Rate_pct, CI_lower_pct, CI_upper_pct,
      Rate_with_95_CI
    )
}

